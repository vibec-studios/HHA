{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "on_true": {
      "type": "minecraft:model",
      "model": "hha:item/heavens_mace_thrown"
    },
    "on_false": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "minecraft:enchantments",
      "ignore_default": true,
      "on_true": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": [
              "gui",
              "ground",
              "fixed",
              "on_shelf"
            ],
            "model": {
              "type": "minecraft:model",
              "model": "hha:item/heavens_mace_ench"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "hha:item/heavens_mace_ench_3d"
        }
      },
      "on_false": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": [
              "gui",
              "ground",
              "fixed",
              "on_shelf"
            ],
            "model": {
              "type": "minecraft:model",
              "model": "hha:item/heavens_mace"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "hha:item/heavens_mace_3d"
        }
      }
    }
  }
}
